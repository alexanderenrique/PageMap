{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pagemap.local/schemas/manifest-v1.schema.json",
  "title": "esp-docpack manifest v1",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "document_id",
    "title",
    "page_count",
    "cover",
    "tile_size",
    "tile_format",
    "pages"
  ],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "esp-docpack" },
    "format_version": { "const": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "page_count": { "type": "integer", "minimum": 1 },
    "cover": { "type": "string", "minLength": 1 },
    "tile_size": { "type": "integer", "minimum": 64, "maximum": 512 },
    "tile_format": { "const": "jpeg" },
    "source": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "filename": { "type": "string" }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
